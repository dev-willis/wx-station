<?xml version="1.0" encoding="UTF-8"?>
<model package="wx"
       baseClass="xPDOObject"
       platform="mysql"
       defaultEngine="InnoDB"
       phpdoc-package="wx"
       version="3.0">

    <!-- Single-row current conditions, replaced on every cron run -->
    <object class="WxCurrent" table="wx_current" extends="xPDOSimpleObject">
        <field key="fetched_at"     dbtype="int"          precision="11"    phptype="integer" null="false" default="0"/>
        <field key="temp"           dbtype="decimal"      precision="5,2"   phptype="float"   null="false" default="0"/>
        <field key="feels_like"     dbtype="decimal"      precision="5,2"   phptype="float"   null="false" default="0"/>
        <field key="humidity"       dbtype="tinyint"      precision="3"     phptype="integer" null="false" default="0"/>
        <field key="pressure"       dbtype="smallint"     precision="5"     phptype="integer" null="false" default="0"/>
        <field key="dew_point"      dbtype="decimal"      precision="5,2"   phptype="float"   null="false" default="0"/>
        <field key="uvi"            dbtype="decimal"      precision="4,1"   phptype="float"   null="false" default="0"/>
        <field key="wind_speed"     dbtype="decimal"      precision="5,2"   phptype="float"   null="false" default="0"/>
        <field key="wind_deg"       dbtype="smallint"     precision="3"     phptype="integer" null="false" default="0"/>
        <field key="sunrise"        dbtype="int"          precision="11"    phptype="integer" null="false" default="0"/>
        <field key="sunset"         dbtype="int"          precision="11"    phptype="integer" null="false" default="0"/>
        <field key="weather_id"     dbtype="smallint"     precision="4"     phptype="integer" null="false" default="800"/>
        <field key="weather_main"   dbtype="varchar"      precision="32"    phptype="string"  null="false" default=""/>
        <field key="weather_desc"   dbtype="varchar"      precision="64"    phptype="string"  null="false" default=""/>
        <field key="weather_icon"   dbtype="varchar"      precision="8"     phptype="string"  null="false" default=""/>
    </object>

    <!-- Hourly forecast, all rows replaced on every cron run -->
    <object class="WxHourly" table="wx_hourly" extends="xPDOSimpleObject">
        <field key="dt"             dbtype="int"          precision="11"    phptype="integer" null="false" default="0" index="unique"/>
        <field key="temp"           dbtype="decimal"      precision="5,2"   phptype="float"   null="false" default="0"/>
        <field key="feels_like"     dbtype="decimal"      precision="5,2"   phptype="float"   null="false" default="0"/>
        <field key="humidity"       dbtype="tinyint"      precision="3"     phptype="integer" null="false" default="0"/>
        <field key="pressure"       dbtype="smallint"     precision="5"     phptype="integer" null="false" default="0"/>
        <field key="dew_point"      dbtype="decimal"      precision="5,2"   phptype="float"   null="false" default="0"/>
        <field key="pop"            dbtype="decimal"      precision="4,3"   phptype="float"   null="false" default="0"/>
        <field key="weather_id"     dbtype="smallint"     precision="4"     phptype="integer" null="false" default="800"/>
        <field key="weather_main"   dbtype="varchar"      precision="32"    phptype="string"  null="false" default=""/>
        <index alias="dt" name="dt" primary="false" unique="true" type="UNIQUE">
            <indexmember field="dt" ascending="true"/>
        </index>
    </object>

    <!-- Daily forecast, all rows replaced on every cron run -->
    <object class="WxDaily" table="wx_daily" extends="xPDOSimpleObject">
        <field key="dt"             dbtype="int"          precision="11"    phptype="integer" null="false" default="0"/>
        <field key="sunrise"        dbtype="int"          precision="11"    phptype="integer" null="false" default="0"/>
        <field key="sunset"         dbtype="int"          precision="11"    phptype="integer" null="false" default="0"/>
        <field key="moonrise"       dbtype="int"          precision="11"    phptype="integer" null="false" default="0"/>
        <field key="moonset"        dbtype="int"          precision="11"    phptype="integer" null="false" default="0"/>
        <field key="moon_phase"     dbtype="decimal"      precision="4,2"   phptype="float"   null="false" default="0"/>
        <field key="temp_min"       dbtype="decimal"      precision="5,2"   phptype="float"   null="false" default="0"/>
        <field key="temp_max"       dbtype="decimal"      precision="5,2"   phptype="float"   null="false" default="0"/>
        <field key="weather_id"     dbtype="smallint"     precision="4"     phptype="integer" null="false" default="800"/>
        <field key="weather_main"   dbtype="varchar"      precision="32"    phptype="string"  null="false" default=""/>
    </object>

    <!-- Observation log, grows forever -->
    <object class="WxLog" table="wx_log" extends="xPDOSimpleObject">
        <field key="recorded_at"    dbtype="int"          precision="11"    phptype="integer" null="false" default="0" index="index"/>
        <field key="temp"           dbtype="decimal"      precision="5,2"   phptype="float"   null="false" default="0"/>
        <field key="humidity"       dbtype="tinyint"      precision="3"     phptype="integer" null="false" default="0"/>
        <field key="pressure"       dbtype="smallint"     precision="5"     phptype="integer" null="false" default="0"/>
        <index alias="recorded_at" name="recorded_at" primary="false" unique="false" type="BTREE">
            <indexmember field="recorded_at" ascending="true"/>
        </index>
    </object>

</model>